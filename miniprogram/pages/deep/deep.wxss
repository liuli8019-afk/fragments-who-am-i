.deep-page.dark { background: var(--ink); color: var(--paper); min-height: 100vh; }

.cloud { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 32rpx 48rpx; padding: 64rpx 0; }
.cw { font-family: "Songti SC", serif; line-height: 1.3; color: var(--paper); }

.reveal { margin-top: 32px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.16); }
.reveal .lab { font-size: 20rpx; letter-spacing: 2px; color: rgba(255,255,255,.45); margin-bottom: 24rpx; }
.revealrow { display: flex; flex-wrap: wrap; gap: 16rpx 32rpx; }
.domitem { font-family: "Songti SC", serif; font-size: 27rpx; }

.deepfoot { margin-top: 32px; font-size: 21rpx; line-height: 1.7; color: rgba(255,255,255,.4); text-align: center; }
