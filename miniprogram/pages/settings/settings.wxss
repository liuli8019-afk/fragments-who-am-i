.sechead { font-size: 20rpx; letter-spacing: 3px; color: var(--dust); margin: 48rpx 0 20rpx; }
.sechead:first-child { margin-top: 8rpx; }
.tipline { font-size: 23rpx; line-height: 1.8; color: var(--graphite); margin: 0 0 20rpx; }
.tipline.warn { color: var(--coral); }

.field { margin-bottom: 24rpx; }
.flabel { display: block; font-size: 23rpx; color: var(--graphite); margin-bottom: 12rpx; }
.input {
  width: 100%; border: 1px solid var(--line); border-radius: 12rpx; background: var(--paper);
  padding: 20rpx 24rpx; font-size: 26rpx; color: var(--ink);
}
.pickerbox {
  border: 1px solid var(--line); border-radius: 12rpx; background: var(--paper);
  padding: 20rpx 24rpx; font-size: 26rpx; color: var(--ink);
}

.testout { margin-top: 16rpx; font-size: 23rpx; color: var(--graphite); }
.testout.warn { color: var(--coral); }

.statline { font-size: 23rpx; color: var(--graphite); }

.rules { font-size: 24rpx; line-height: 2; color: var(--graphite); }
.ruleitem { margin-bottom: 4rpx; }
