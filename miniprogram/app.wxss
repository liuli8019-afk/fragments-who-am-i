/* app.wxss —— 全局样式,变量和取色跟网页版 index.html 的 :root 一一对应。
   小程序里没有 :root,用 page 选择器代替;也没有 body.dark 这种写法,
   深色态改用 page 上挂一个 dark class,每个页面自己决定要不要挂。 */

page {
  --paper: #FFFFFF; --mist: #FAF8F5; --line: #E9E5DE; --ink: #17161A;
  --graphite: #6E6A66; --dust: #B4AEA4; --sage: #7C8F73; --indigo: #35415E; --coral: #B4544A;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}
page.dark {
  background: var(--ink);
  color: var(--paper);
}
view, text, button, input, textarea { box-sizing: border-box; }
button::after { border: none; }
button { background: none; padding: 0; margin: 0; line-height: normal; font-size: inherit; }

.wrap { padding: 24px 24px 100px; min-height: 100vh; }

.topbar { display: flex; justify-content: flex-end; margin-bottom: 16px; }
.lang { font-size: 22rpx; letter-spacing: 2px; color: var(--dust); padding: 8px; }
.dark .lang { color: rgba(255,255,255,.45); }

.ttl { font-size: 52rpx; line-height: 1.3; letter-spacing: 1px; margin: 0; font-family: "Songti SC", serif; }
.sub { margin: 16rpx 0 0; font-size: 26rpx; line-height: 1.7; color: var(--graphite); }
.dark .sub { color: rgba(255,255,255,.6); }

.demolink { display: inline-block; margin-top: 20rpx; font-size: 24rpx; color: var(--sage); text-decoration: underline; }

.previewbar {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--mist); border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 32rpx;
  font-size: 24rpx; color: var(--graphite);
}
.dark .previewbar { background: rgba(255,255,255,.08); color: rgba(255,255,255,.65); }
.previewbar .act { color: var(--ink); text-decoration: underline; }
.dark .previewbar .act { color: var(--paper); }

.back { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--graphite); margin-bottom: 48rpx; }
.dark .back { color: rgba(255,255,255,.55); }
.empty { font-size: 26rpx; line-height: 1.7; color: var(--graphite); }
.dark .empty { color: rgba(255,255,255,.55); }

.btn {
  border: 1px solid var(--line); background: var(--paper); border-radius: 12rpx;
  padding: 18rpx 32rpx; font-size: 26rpx; color: var(--ink); text-align: center;
}
.btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.btn.danger { color: var(--coral); }
.dark .btn { background: transparent; border-color: rgba(255,255,255,.25); color: var(--paper); }
.dark .btn.primary { background: var(--paper); color: var(--ink); }

.row { display: flex; flex-wrap: wrap; align-items: center; gap: 20rpx; }
